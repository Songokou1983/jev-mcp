# Required — server reads this if env var not set.
# Get from https://docs.typesafe.ai (account → API key).
TYPESAFE_API_KEY=apikey_your_key_here

# REQUIRED on hosts whose direct egress is region-blocked (HTTP 451
# "Typesafe is not available in your region"). Unset = direct connection,
# which currently fails from this machine.
#
# JEV_API_PROXY is a jev-mcp specific variable. The standard HTTPS_PROXY /
# HTTP_PROXY env vars do NOT work here: JevClient builds httpx clients with
# trust_env=False (2026-09-22 fix for an intermittently failing local proxy),
# so env proxies are never picked up. The proxy has to be passed explicitly.
JEV_API_PROXY=http://127.0.0.1:7897